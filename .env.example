# Vorlage. Kopieren nach .env (gitignoriert) und ausfuellen.
#
#   cp .env.example .env
#
# Erzeugen laeuft lokal auf der GPU. BEWERTEN nicht: Prompt-Treue und
# Textrendering fragen ein Vision-Modell ueber einen OpenAI-kompatiblen
# Endpunkt. Ohne diese Werte laeuft nur `--no-score`.

# Basis-URL des Judge, ohne /v1. Kein Standardwert im Code — welche Maschine
# das ist, gehoert nicht in ein oeffentliches Repository.
JUDGE_ENDPOINT=http://judge.example:4000

# Modell dort. Ein Judge fuer Treue und OCR gleichermassen.
JUDGE_MODEL=qwen/qwen3.7-plus

# Schluessel fuer den Endpunkt.
VISION_API_KEY=<hier-eintragen>

# Optional.
VISION_MAX_TOKENS=2048

# Nur fuer eval/ernie_field.sh: laufender Container auf einer anderen Maschine
# und der SSH-Name, unter dem er danach abgeraeumt wird.
# ERNIE_ENDPOINT=http://worker.example:8011
# ERNIE_SSH_HOST=worker
