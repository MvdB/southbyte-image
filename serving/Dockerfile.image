# southbyte-image — diffusers Text-to-Image Serving-Container (DGX Spark / GB10, aarch64).
# NGC-PyTorch-Basis wie bei southbyte-tts (CUDA passend zu sm_120), diffusers obendrauf.
FROM nvcr.io/nvidia/pytorch:26.06-py3

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONUNBUFFERED=1

# diffusers 0.38 deckt FluxPipeline + QwenImagePipeline ab; torch kommt aus dem Basis-Image.
RUN pip install --no-cache-dir \
      "diffusers==0.38.0" \
      "transformers>=4.49" \
      accelerate safetensors sentencepiece protobuf \
      fastapi "uvicorn[standard]" pydantic

COPY server_image.py /opt/southbyte-image/server_image.py
WORKDIR /opt/southbyte-image

EXPOSE 8010
CMD ["python", "server_image.py"]
