# southbyte-image Serving-Container v2 — universelles Image für ALLE Bild-Familien.
# Baut auf v1 (diffusers-auto + custom-class) auf und ergänzt die schweren Deps EINMAL,
# damit mage_flow- und flux2_singlefile-Loader laufen. Die mit ⚠️ markierten Layer sind
# die wackeligen sm_120/aarch64-Bauten — beim Bauen verifizieren.
FROM nvcr.io/nvidia/pytorch:26.06-py3

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONUNBUFFERED=1

# ── Basis (wie v1): diffusers 0.38 deckt FluxPipeline/QwenImage/Flux2/Ernie ab ──
# 2026-08-11: transformers <5.6 PFLICHT für mage_flow — 5.6.0 entfernte den input_embeds-kwarg
# von create_causal_mask, was mage_flows Qwen3VL-Encoder (Screening UND Konditionierung) crasht
# (TypeError → screen_text fail-closed → alle Prompts blockiert). mage_flow pyproject: <5.6.
RUN pip install --no-cache-dir \
      "diffusers==0.38.0" \
      "transformers>=5.5,<5.6" \
      accelerate safetensors sentencepiece protobuf pyyaml \
      fastapi "uvicorn[standard]" pydantic

# ── flash-attn: BEWUSST NICHT gebaut (2026-08-11).
# flash-attn 2.8.3 hat auf sm_120/CUDA13 kein Wheel und baut aus Source nur über einen
# Multi-Arch-Compile (sm_80/90/100/120), der bei sicherer Drossel (MAX_JOBS=2) >100 min läuft.
# mage_flow bringt einen vollständigen SDPA-Fallback mit (_attn_backend._resolve_sdpa +
# VF_HF_ATTN_IMPL): funktional äquivalent für die dense/causal-Pfade, die mage_flow nutzt,
# nur minimal langsamer. Wir erzwingen sdpa via Env unten + ImportError→sdpa-Fallback im Code.
# ninja/setuptools/wheel bleiben (nunchaku/torchao brauchen sie ggf.).
ENV VF_HF_ATTN_IMPL=sdpa
RUN pip install --no-cache-dir ninja setuptools wheel

# ── mage_flow (github.com/microsoft/Mage, Verzeichnis mage_flow/) ──
# Erwartet den geklonten Code unter build-context ./_vendor/mage_flow (COPY unten),
# oder ersetze durch: RUN pip install "git+https://github.com/microsoft/Mage#subdirectory=mage_flow"
COPY _vendor/mage_flow /opt/vendor/mage_flow
# 2026-08-11: mage_flow-Laufzeit-Deps EXPLIZIT (leichte, reine-Python). --no-deps unten
# verhindert bewusst, dass mage_flow torch/diffusers/transformers überschreibt — die sind
# schon im Image. Diese hier fehlten dadurch (loguru → ImportError). gradio ist nur für die
# Demo-app.py, nicht für MageFlowPipeline → weggelassen.
RUN pip install --no-cache-dir loguru einops pillow huggingface_hub \
 && pip install --no-cache-dir --no-deps -e /opt/vendor/mage_flow || \
    echo "WARN mage_flow nicht installiert (Code fehlt im Build-Context?)"

# ── NVFP4-Backend für FLUX.2-Single-File ──
# 2026-08-11: torchao ist der von diffusers benötigte Deserializer — die FLUX.2-NVFP4-Checkpoints
# sind torchao-serialisiert (sonst "Unable to import torchao Tensor objects" + Konverter-Crash
# 'chunk expects >=1-dim'). Vorher schluckte 'nunchaku || torchao' das torchao (nunchaku gewann).
# Beide installieren, torchao zuerst (der kritische Pfad).
RUN pip install --no-cache-dir torchao  || echo "WARN torchao nicht installiert"
RUN pip install --no-cache-dir nunchaku || echo "WARN nunchaku nicht installiert"

# 2026-08-11: diffusers-ModelOpt-Quantizer-Fix. create_quantized_param baut nn.Parameter aus
# den gepackten uint8-NVFP4-Weights OHNE requires_grad=False → RuntimeError ("Only Tensors of
# floating point... can require gradients"). requires_grad an den dtype koppeln behebt das →
# FLUX.2-NVFP4(-mixed) lädt. Idempotent (grep-guard).
RUN Q=$(python -c "import diffusers.quantizers.modelopt.modelopt_quantizer as m; print(m.__file__)") \
 && sed -i 's|torch.nn.Parameter(param_value.to(device=target_device))|torch.nn.Parameter(param_value.to(device=target_device), requires_grad=param_value.is_floating_point())|' "$Q" \
 && grep -q 'requires_grad=param_value.is_floating_point' "$Q" && echo "modelopt-Patch ok" || echo "WARN modelopt-Patch nicht gesetzt"

# ── Server + Loader-Registry ──
# 2026-08-11: serving/-Prefix — v2 baut mit Context=Repo-Root (nötig für COPY _vendor/mage_flow
# oben), daher liegen server_image.py/loaders.py unter serving/, nicht im Context-Root (v1 baute
# mit Context=serving/ und hatte kein _vendor). Ohne Prefix: BuildKit-Checksum-Fail "not found".
COPY serving/server_image.py serving/loaders.py /opt/southbyte-image/
WORKDIR /opt/southbyte-image

EXPOSE 8010
CMD ["python", "server_image.py"]
